# OPTIONAL local-dev overrides only. On the server, deploy generates:
# - /opt/trading-bot/api/.env for the API;
# - /opt/trading-bot/postgres/.env for Postgres;
# - /opt/trading-bot/spot/live/.env for the live spot worker, created only if missing;
# - /opt/trading-bot/spot/virtual/.env for the virtual spot worker.
# Any TRADINGBOT_* var set here overrides the matching appsettings value for a local
# `dotnet run`; unset vars fall back to appsettings.
TRADINGBOT_MARKET_DATA_MODE=kraken
TRADINGBOT_RUN_ONCE=false
TRADINGBOT_LOOP_INTERVAL_SECONDS=300
TRADINGBOT_BOT_INSTANCE_ID=virtual
TRADINGBOT_BOT_INSTANCE_NAME=Local virtual worker
# Kraken private API (never commit real values). Key needs Query Funds + Create/Modify Orders,
# NO withdrawal permission.
TRADINGBOT_DB_PASSWORD=
POSTGRES_PASSWORD=
TRADINGBOT_DATABASE_ENABLED=true
TRADINGBOT_DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=tradingbot;Username=tradingbot;Password=change-me
TRADINGBOT_LOG_DIRECTORY=logs
TRADINGBOT_KRAKEN_API_KEY=
TRADINGBOT_KRAKEN_API_SECRET=
TRADINGBOT_AI_PROVIDER=openai-compatible
TRADINGBOT_AI_BASE_URL=https://api.openai.com/v1
TRADINGBOT_AI_MODEL=gpt-5.4-mini
TRADINGBOT_AI_WATCHLIST_REFRESH_SECONDS=3600
TRADINGBOT_OPENAI_API_KEY=
# On production deploy this flag is written to /opt/trading-bot/spot/live/.env only when that file is first created.
# /opt/trading-bot/spot/virtual/.env always forces false.
TRADINGBOT_LIVE_TRADING_ENABLED=false
TRADINGBOT_MAX_ACTIVE_INSTRUMENTS=5
TRADINGBOT_MAX_ORDER_EUR=3
TRADINGBOT_STARTING_CASH_EUR=50
TRADINGBOT_DRY_RUN_OUTPUT_DIRECTORY=data/dry-run
TRADINGBOT_DRY_RUN_APPLY_VIRTUAL_FILLS=true
TRADINGBOT_DRY_RUN_TAKER_FEE_BPS=26
TRADINGBOT_DRY_RUN_SLIPPAGE_BPS=5
# Staged strategy toggles (disabled by default in appsettings). Enable ONE AT A TIME
# in dry-run for evaluation, in this order: 2.1 -> 2.2 -> 2.4, ~1 day each.
# 2.1 Exit hysteresis: flip a held position only on a confirmed bearish cross (0 = old behavior).
#TRADINGBOT_STRATEGY_EXIT_EMA_GAP_PERCENT=0.15
# 2.2 Trailing stop: arm at +activation%, sell after a distance% retrace (0 disables).
#TRADINGBOT_POSITION_EXIT_TRAILING_ACTIVATION_PERCENT=1.5
#TRADINGBOT_POSITION_EXIT_TRAILING_DISTANCE_PERCENT=1.0
# 2.4 UTC entry blackout: block new entries for N minutes after the given UTC hour (0 min disables).
#TRADINGBOT_EXECUTION_ENTRY_BLACKOUT_UTC_FROM_HOUR=0
#TRADINGBOT_EXECUTION_ENTRY_BLACKOUT_MINUTES=60

# --- Trade-economics / entry-quality gates (defaults live in appsettings.json) ---
# Friction filters ENTRIES (it never widens the stop): TP distance must be at least
# this multiple of round-trip friction (fees both ways + spread + slippage both ways).
#TRADINGBOT_STRATEGY_MIN_TAKE_PROFIT_TO_FRICTION_RATIO=3.0
# Anti-extension: reject entries more than X% above fast EMA / after a Y% snapshot run-up.
#TRADINGBOT_STRATEGY_MAX_ENTRY_EXTENSION_PERCENT=0.6
#TRADINGBOT_STRATEGY_MAX_ENTRY_RUNUP_PERCENT=2.5
# Early-entry channel (forming EMA cross, widening gap, RSI in band, tolerates -0.2% pullback).
#TRADINGBOT_STRATEGY_EARLY_ENTRY_ENABLED=true
#TRADINGBOT_STRATEGY_EARLY_ENTRY_ALLOWED_IN_LIVE=true
#TRADINGBOT_STRATEGY_EARLY_ENTRY_MIN_EMA_GAP_PERCENT=0.10
#TRADINGBOT_STRATEGY_EARLY_ENTRY_MAX_RANK=1
# Market-regime filter: block NEW long entries when XBT 24h <= -X% AND breadth < Y% positive.
#TRADINGBOT_STRATEGY_REGIME_FILTER_MAX_BTC_DECLINE_PERCENT=1.0
#TRADINGBOT_STRATEGY_REGIME_FILTER_MIN_BREADTH_PERCENT=40

# Execution / risk throttles. The correlation-risk groups live in appsettings.json
# (CorrelationRisk) since they are nested; the scalar toggles below can be overridden here.
# Hourly entry throttle: max NEW entries per rolling 60 minutes (0 disables).
#TRADINGBOT_EXECUTION_MAX_NEW_POSITIONS_PER_HOUR=2
# Extra per-pair cooldown after a stop-loss, in seconds, additive to the sell cooldown (0 disables).
#TRADINGBOT_EXECUTION_COOLDOWN_AFTER_STOP_LOSS_SECONDS=14400
# Controlled-loss floor for CONFIRMED bearish flips: exit while PnL% >= this loss floor (0 disables).
#TRADINGBOT_POSITION_EXIT_MAX_SIGNAL_FLIP_LOSS_EXIT_PERCENT=-1.2
