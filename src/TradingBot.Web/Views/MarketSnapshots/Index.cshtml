@model PageViewModel<MarketSnapshotViewModel>
@{ ViewData["Title"] = "Market snapshots"; ViewData["PageTitle"] = "Market snapshots"; }
<main class="page">@await Html.PartialAsync("_ShellHeader", Model.Shell) @await Html.PartialAsync("_Notice", Model.Notice ?? "")
<section class="panel"><div class="panel-head"><h2>Snapshots</h2><form method="get" class="inline-form"><input name="botInstanceId" type="hidden" value="@Model.Shell.BotInstanceId" /><input name="pair" value="@ViewBag.Pair" placeholder="SOL/EUR" /><button>Filter</button></form></div><div class="card-list">
@foreach (var s in Model.Items) { <article class="row-card"><div><b>@s.Pair</b><small>@s.BotInstanceId</small></div><div><span class="num">€@(s.Price?.ToString("0.####") ?? "—")</span><small>price</small></div><div><span class="num">@(s.ChangePercent?.ToString("0.00") ?? "—")%</span><small>change</small></div><div><span class="num">@s.Utc.ToString("MM-dd HH:mm")</span><small>utc</small></div></article> }
@if (!Model.Items.Any()) { <p class="empty">No market snapshots.</p> }</div></section></main>
