    "BtcPair": "XBT/USD",
    "BtcTrendMa": 50,
    "BtcSlopeLookback": 3,
    "BtcCrashLookback": 4,
    "BtcCrashPct": 2.0,
    "LongOverrideMinScore": 0.85,
