{
  "BotInstance": {
    "Id": "futures-virtual",
    "Name": "Virtual futures worker"
  },
  "Worker": {
    "RunOnce": false,
    "LoopIntervalSeconds": 120
  },
  "Http": {
    "TimeoutSeconds": 20
  },
  "Kraken": {
    "MarketDataMode": "database",
    "BaseUrl": "https://futures.kraken.com"
  },
  "Logging": {
    "Directory": "logs"
  },
  "Trading": {
    "TimeframeMinutes": 15,
    "MaxActiveInstruments": 50,
    "StrongMoverMinChangePercent": 3.0,
    "StrongMoverMinDailyVolumeEur": 10000
  },
  "Strategy": {
    "FastEmaPeriod": 9,
    "SlowEmaPeriod": 21,
    "RsiPeriod": 14,
    "MinimumEmaGapPercent": 0.2,
    "MinimumLongScore": 0.8,
    "MaxEntrySpreadPercent": 0.25,
    "MaxEntryExtensionPercent": 1.0,
    "MaxEntryRunupPercent": 2.5,
    "NegativePriceActionPenalty": 0.05,
    "NegativePriceActionPenaltyThresholdPercent": 0.2,
    "PriceActionLookbackSnapshots": 6,
    "PriceActionMinSnapshots": 4,
    "PriceActionMaxDeclinePercent": 0.5,
    "PriceActionMaxNonRisingSnapshots": 3,
    "PriceActionMaxSampleAgeMinutes": 30,
    "PriceActionHydrationMinutes": 45,
    "RequirePriceActionData": false
  },
  "Futures": {
    "MaxLeverage": 10.0,
    "DefaultLeverage": 10.0,
    "MaxPositions": 3,
    "AllowShorts": true,
    "TargetMarginEur": 40,
    "MaxNotionalEur": 400,
    "MaxTotalNotionalEur": 1200,
    "MaxMarginPerPositionEur": 40,
    "UsdPerEur": 1.08,
    "FastExitCheckSeconds": 10,
    "LiveTradingEnabled": false,
    "DeadManSwitchEnabled": false,
    "DeadManSwitchSeconds": 180
  },
  "Margin": {
    "MaintenanceMarginRatePercent": 0.5,
    "MinLiquidationDistancePercent": 8,
    "MaxAccountMarginUtilizationPercent": 80
  },
  "Fees": {
    "MakerPct": 0.02,
    "TakerPct": 0.05
  },
  "Funding": {
    "MaxAbsFundingRatePercentForEntry": 0.03,
    "FundingLookbackHours": 8
  },
  "Entry": {
    "MakerFillTimeoutSec": 60,
    "MakerRepegs": 1,
    "MaxQueueAheadMultiple": 5,
    "MaxEntryPriceDeviationPct": 0.35
  },
  "Freshness": {
    "FreshContinuationMin24hRangePositionPct": 50,
    "MaxContinuationRangePositionPct": 80,
    "NearHighMin24hRangePositionPct": 88,
    "NearHighMaxDistanceFromRecentHighPct": 0.5,
    "RecentHighLookbackCandles": 12,
    "FreshTapeSnapshotCount": 3,
    "FreshTapeMinSlopePct": 0.05,
    "FreshTapeMinPositiveSteps": 2,
    "BreakoutMinAboveRecentHighPct": 0.05,
    "ContinuationCandleMomentumLookback": 4,
    "MinContinuationCandleMomentumPct": 0,
    "LocalHighLookbackClosedCandles": 2,
    "MaxEntryDistanceFromLocalHighPct": 0.12,
    "BreakoutHoldSnapshotCount": 2,
    "MaxEntryDriftFromSignalPct": 0.10,
    "LongRangeGuardEnabled": true,
    "Max24hRangePositionForLong": 30,
    "MinReboundFrom24hLowPct": 0.20,
    "RequiredRisingSnapshotCount": 2,
    "RequirePositiveShortSlope": true,
    "RequireFreshTapeForLowRangeLong": true,
    "RobustRangeMinSampleCount": 20,
    "Min24hRangeWidthPct": 0.50
  },
  "Dip": {
    "Enabled": true,
    "NearLowMax24hRangePositionPct": 25,
    "MinScore": 0.70,
    "MinCandleMomentumPct": 0.10
  },
  "Filters": {
    "MinQuoteVolume24h": 50000,
    "MinExitDepthMultiple": 5,
    "MaxExitImpactPct": 0.5
  },
  "Exits": {
    "StopAtrMult": 1.0,
    "MinStopAtrFloor": 1.5,
    "TakeProfitAtrMult": 3.0,
    "MinTpVsCostMult": 3.0,
