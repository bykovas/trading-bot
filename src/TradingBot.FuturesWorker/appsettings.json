{
  "BotInstance": {
    "Id": "futures-virtual",
    "Name": "Virtual futures worker"
  },
  "Worker": {
    "RunOnce": false,
    "LoopIntervalSeconds": 120
  },
  "Http": {
    "TimeoutSeconds": 20
  },
  "Kraken": {
    "MarketDataMode": "database",
    "BaseUrl": "https://futures.kraken.com"
  },
  "Logging": {
    "Directory": "logs"
  },
  "Trading": {
    "TimeframeMinutes": 15,
    "MaxActiveInstruments": 50,
    "StrongMoverMinChangePercent": 3.0,
    "StrongMoverMinDailyVolumeEur": 10000
  },
  "Strategy": {
    "FastEmaPeriod": 9,
    "SlowEmaPeriod": 21,
    "RsiPeriod": 14,
    "MinimumEmaGapPercent": 0.20,
    "MinimumLongScore": 0.80,
    "MaxEntrySpreadPercent": 0.25,
    "MaxEntryExtensionPercent": 1.0,
    "MaxEntryRunupPercent": 2.5,
    "NegativePriceActionPenalty": 0.05,
    "NegativePriceActionPenaltyThresholdPercent": 0.2,
    "PriceActionLookbackSnapshots": 6,
    "PriceActionMinSnapshots": 4,
    "PriceActionMaxDeclinePercent": 0.5,
    "PriceActionMaxNonRisingSnapshots": 3,
    "PriceActionMaxSampleAgeMinutes": 30,
    "PriceActionHydrationMinutes": 45,
    "RequirePriceActionData": false
  },
  "Futures": {
    "MaxLeverage": 10.0,
    "DefaultLeverage": 10.0,
    "MaxPositions": 3,
    "AllowShorts": true,
    "TargetNotionalEur": 10,
    "FastExitCheckSeconds": 10,
    "LiveTradingEnabled": false,
    "DeadManSwitchSeconds": 180
  },
  "Margin": {
    "MaintenanceMarginRatePercent": 0.5,
    "MinLiquidationDistancePercent": 8,
    "MaxAccountMarginUtilizationPercent": 50
  },
  "Fees": {
    "MakerPct": 0.02,
    "TakerPct": 0.05
  },
  "Funding": {
    "MaxAbsFundingRatePercentForEntry": 0.03,
    "FundingLookbackHours": 8
  },
  "Entry": {
    "MakerFillTimeoutSec": 60,
    "MakerRepegs": 1,
    "MaxQueueAheadMultiple": 5
  },
  "Filters": {
    "MinQuoteVolume24h": 50000,
    "MinExitDepthMultiple": 5,
    "MaxExitImpactPct": 0.5
  },
  "Exits": {
    "StopAtrMult": 2.0,
    "MinStopAtrFloor": 1.5,
    "TakeProfitAtrMult": 3.0,
    "MinTpVsCostMult": 3.0,
    "SlippageBufferPct": 0.10,
    "MaxHoldMinutes": 360,
    "TrailingActivationBufferPct": 0
  },
  "Regime": {
    "BtcPair": "XBT/USD",
    "BtcTrendMa": 50,
    "BtcSlopeLookback": 3,
    "BtcCrashLookback": 4,
    "BtcCrashPct": 2.0
  },
  "Shorts": {
    "MaxChaseDrawdownPct": 3.0,
    "MinShortScore": 0.85
  },
  "Risk": {
    "MaxConcurrentOpenRisk": 1.5,
    "EstimatedEmergencyExitCostPct": 0
  },
  "ExecutionPolicy": {
    "CooldownAfterCloseSeconds": 1800,
    "CooldownAfterStopLossSeconds": 14400,
    "MinHoldSeconds": 1800,
    "EntryBlackoutUtcFromHour": 22,
    "EntryBlackoutMinutes": 360
  },
  "CorrelationRisk": {
    "MaxOpenPositionsPerGroup": 1,
    "MaxExposureEurPerGroup": 10,
    "HighBetaGroups": ["BTC_BETA", "ETH_BETA", "L1_L2", "PAYMENTS", "DEFI", "MEME"],
    "Groups": {
      "BTC_BETA": ["XBT/USD"],
      "ETH_BETA": ["ETH/USD"],
      "L1_L2": ["SOL/USD", "ADA/USD", "AVAX/USD", "NEAR/USD", "SUI/USD", "DOT/USD", "ATOM/USD", "ALGO/USD", "FIL/USD", "ICP/USD", "TON/USD"],
      "PAYMENTS": ["XRP/USD", "LTC/USD", "BCH/USD", "XLM/USD", "TRX/USD", "XDG/USD"],
      "DEFI": ["AAVE/USD", "LINK/USD", "UNI/USD", "INJ/USD", "JUP/USD", "CRV/USD", "ONDO/USD", "DYDX/USD"],
      "MEME": ["WIF/USD", "FARTCOIN/USD", "HMSTR/USD", "TOSHI/USD"]
    }
  },
  "TpSl": {
    "Enabled": true,
    "TakeProfitPercent": 3.0,
    "StopLossPercent": 2.0,
    "TriggerSource": "mark"
  },
  "Portfolio": {
    "StartingCashEur": 100
  },
  "DryRun": {
    "Enabled": true,
    "ApplyVirtualFills": true,
    "OutputDirectory": "data/dry-run",
    "StateFile": "portfolio-state.json",
    "EventsFile": "events.jsonl",
    "TakerFeeBps": 5,
    "SlippageBps": 5
  },
  "Database": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "MarketDataConsumer": {
    "Venue": "futures",
    "FallbackEnabled": true,
    "MaxQuoteAgeSeconds": 120,
    "MaxCandleAgeMinutes": 15,
    "MaxCandleBars": 120
  },
  "UniverseDiscovery": {
    "Enabled": true,
    "RefreshSeconds": 3600,
    "IncludeConfiguredUniverse": true,
    "ForceInclude": ["XBT/USD"],
    "Blacklist": []
  },
