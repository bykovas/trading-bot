{
  "BotInstance": {
    "Id": "futures-virtual",
    "Name": "Virtual futures worker"
  },
  "Worker": {
    "RunOnce": false,
    "LoopIntervalSeconds": 120
  },
  "Http": {
    "TimeoutSeconds": 20
  },
  "Kraken": {
    "MarketDataMode": "kraken-futures",
    "BaseUrl": "https://futures.kraken.com"
  },
  "Logging": {
    "Directory": "logs"
  },
  "Trading": {
    "TimeframeMinutes": 15,
    "MaxActiveInstruments": 20
  },
  "Strategy": {
    "FastEmaPeriod": 9,
    "SlowEmaPeriod": 21,
    "RsiPeriod": 14,
    "MinimumEmaGapPercent": 0.30,
    "MinimumLongScore": 0.85
  },
  "Futures": {
    "MaxLeverage": 2.0,
    "DefaultLeverage": 1.0,
    "MaxPositions": 3,
    "AllowShorts": true,
    "TargetNotionalEur": 10
  },
  "Margin": {
    "MaintenanceMarginRatePercent": 0.5,
    "MinLiquidationDistancePercent": 15,
    "MaxAccountMarginUtilizationPercent": 50
  },
  "Funding": {
    "MaxAbsFundingRatePercentForEntry": 0,
    "FundingLookbackHours": 8
  },
  "TpSl": {
    "Enabled": true,
    "TakeProfitPercent": 3.0,
    "StopLossPercent": 2.0,
    "TriggerSource": "mark"
  },
  "Portfolio": {
    "StartingCashEur": 100
  },
  "DryRun": {
    "Enabled": true,
    "ApplyVirtualFills": true,
    "OutputDirectory": "data/dry-run",
    "StateFile": "portfolio-state.json",
    "EventsFile": "events.jsonl",
    "TakerFeeBps": 5,
    "SlippageBps": 5
  },
  "Database": {
    "Enabled": false,
    "ConnectionString": ""
  },
