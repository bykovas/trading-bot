{
  "BotInstance": {
    "Id": "futures-virtual",
    "Name": "Virtual futures worker"
  },
  "Worker": {
    "RunOnce": false,
    "LoopIntervalSeconds": 180
  },
  "Http": {
    "TimeoutSeconds": 20
  },
  "Kraken": {
    "MarketDataMode": "sample",
    "BaseUrl": "https://futures.kraken.com"
  },
  "Logging": {
    "Directory": "logs"
  },
  "Trading": {
    "TimeframeMinutes": 15,
    "MaxActiveInstruments": 5
  },
  "Strategy": {
    "FastEmaPeriod": 9,
    "SlowEmaPeriod": 21,
    "RsiPeriod": 14,
    "MinimumEmaGapPercent": 0.35,
    "MinimumLongScore": 0.90
  },
  "Futures": {
    "MaxLeverage": 2.0,
    "DefaultLeverage": 1.0,
    "MaxPositions": 1,
    "AllowShorts": true,
    "TargetNotionalEur": 10
  },
  "Margin": {
    "MaintenanceMarginRatePercent": 0.5,
    "MinLiquidationDistancePercent": 15,
    "MaxAccountMarginUtilizationPercent": 50
  },
  "Funding": {
    "MaxAbsFundingRatePercentForEntry": 0,
    "FundingLookbackHours": 8
  },
  "TpSl": {
    "Enabled": true,
    "TakeProfitPercent": 3.0,
    "StopLossPercent": 2.5,
    "TriggerSource": "mark"
  },
  "Portfolio": {
    "StartingCashEur": 100
  },
  "DryRun": {
    "Enabled": true,
    "ApplyVirtualFills": true,
    "OutputDirectory": "data/dry-run",
    "StateFile": "portfolio-state.json",
    "EventsFile": "events.jsonl",
    "TakerFeeBps": 5,
    "SlippageBps": 5
  },
  "Database": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "CandidateUniverse": [
    {
      "Pair": "XBT/EUR",
      "KrakenPair": "PF_XBTEUR",
      "Venue": "KrakenFutures",
      "Enabled": true
    },
    {
      "Pair": "ETH/EUR",
      "KrakenPair": "PF_ETHEUR",
      "Venue": "KrakenFutures",
      "Enabled": true
    },
    {
      "Pair": "SOL/EUR",
      "KrakenPair": "PF_SOLEUR",
      "Venue": "KrakenFutures",
      "Enabled": true
    },
    {
      "Pair": "XRP/EUR",
      "KrakenPair": "PF_XRPEUR",
      "Venue": "KrakenFutures",
      "Enabled": true
    },
    {
      "Pair": "ADA/EUR",
      "KrakenPair": "PF_ADAEUR",
      "Venue": "KrakenFutures",
      "Enabled": true
    }
  ]
}
